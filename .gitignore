# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- QA 运行期产物（默认落在 profile.data_dir，通常在项目外；
#      若把 data_dir 设到了项目内，这些目录也不入库） ----
/data/
/shots/
/watch/
/state/
*.png
*.jpg
# 但保留仓库文档/示例图（如 docs/ 下的说明图）
!docs/**

# 说明：profiles/*.json 是版本控制的（每游戏配置示例）。
# 注意其中可能含机器相关的绝对路径（savedata_dir/data_dir），私有仓库可接受；
# 若要公开，请把真实路径改成占位再提交。

# 公开仓库只提交通用示例 profile；各游戏的个人 profile（含本机路径）只留本地
/profiles/*.json
!/profiles/example.json
