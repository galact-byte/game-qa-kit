@SYSTEM_TITLE
SETCOLOR 240,240,240
PRINTL GAMEQA STORAGE - ENTER TO SAVE OR LOAD
WAIT
IF CHKDATA(1) == 0
    LOADDATA 1
ENDIF
FLAG:0 = 123
SAVEDATA 1, "Self-authored fixture checkpoint"
CLEARLINE LINECOUNT
SETCOLOR 64,220,128
PRINTFORMW SAVED {FLAG:0} - ENTER TO CHANGE
FLAG:0 = 999
CLEARLINE LINECOUNT
SETCOLOR 255,180,64
PRINTFORMW CHANGED {FLAG:0} - ENTER TO LOAD
LOADDATA 1

@SYSTEM_LOADEND
CLEARLINE LINECOUNT
IF FLAG:0 == 123
    SETCOLOR 64,180,255
    PRINTFORMW LOADED {FLAG:0} - ORIGINAL SAVE RESTORED
ELSE
    SETCOLOR 255,64,64
    PRINTFORMW LOAD FAILED - GOT {FLAG:0}
ENDIF
RESTART
